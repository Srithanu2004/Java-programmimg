public class MissingNumbers {
    static void findMissingNumbers(int[] arr, int maxNum) {
        System.out.println("Missing numbers are:");
        
        for (int i = 1; i <= maxNum; i++) {
            int found = 0;

            for (int j = 0; j < arr.length; j++) {
                if (arr[j] == i) {
                    found = 1;
                    break;
                }
            }

            if (found == 0) {
                System.out.print(i + " ");
            }
        }
    }

    public static void main(String[] args) {
        int[] array = {1, 2, 4, 6, 7}; // Suppose range is 1 to 7
        int maxValue = 7;

        findMissingNumbers(array, maxValue);
    }
}
